# Copy into your local environment only; never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/superbajaar
CORS_ALLOWED_ORIGINS=http://localhost:5173
DB_POOL_MAX=5
LOG_LEVEL=INFO
PORT=8000

# Admin access: set strong unique values on the production server (never commit real credentials).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_TOKEN_SECRET=replace-with-at-least-32-random-characters
