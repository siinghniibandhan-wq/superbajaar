DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/superbajaar
SB_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
SB_ADMIN_EMAIL=admin@example.com
SB_ADMIN_PASSWORD=change-this-strong-password
SB_CORS_ORIGINS=http://localhost:5173
SB_SERVICEABLE_PINS=
# Clean modular app settings; do not replace the production service until feature parity is verified.
APP_ENV=development
APP_NAME=Super Bajaar API
API_V1_PREFIX=/api/v1
JWT_SECRET_KEY=replace-with-a-long-random-secret
PORT=8001
