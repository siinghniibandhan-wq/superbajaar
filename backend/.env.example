# Clean modular backend settings (copy into a local .env and replace placeholders).
# Never commit real credentials. Never point local tests at production.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/superbajaar_test
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_ENV=development
APP_NAME=Super Bajaar API
API_PREFIX=/api
JWT_SECRET_KEY=generate-a-random-secret-at-least-32-characters
# If migrating an existing deployment, SB_SECRET_KEY is accepted as a temporary fallback.
PORT=8001

# Legacy signing-secret fallback only; never use it as an admin password.
# Email allowed for the operator-run first Super Admin provisioning command.
SB_SUPER_ADMIN_EMAIL=kpmcenterprise@gmail.com
# Non-interactive first-admin bootstrap (AWS SSM Run Command only):
# Set the full name and a Parameter Store SecureString name; never put the password here.
# SB_SUPER_ADMIN_FULL_NAME=Your Full Name
# SB_SUPER_ADMIN_PASSWORD_PARAMETER=/superbajaar/bootstrap/super-admin-password
SB_SERVICEABLE_PINS=

# Razorpay Standard Checkout (use Test Mode credentials until test verification is complete).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Invitation-only Vendor and Employee portal delivery.
SB_PORTAL_BASE_URL=https://your-current-website-url
# Set SB_EMAIL_PROVIDER=resend to use Resend; otherwise SMTP remains the default.
SB_EMAIL_PROVIDER=smtp
RESEND_API_KEY=
# Required for Resend's unverified testing sender; must match the Resend account email.
RESEND_TEST_RECIPIENT=
SB_PORTAL_BASE_URL=https://your-current-website-url
SB_SMTP_HOST=
SB_SMTP_PORT=587
SB_SMTP_USERNAME=
SB_SMTP_PASSWORD=
SB_SMTP_FROM=
# Private invoice-document storage (bucket must block all public access).
SB_PRIVATE_DOCUMENT_BUCKET=
AWS_REGION=ap-south-1
