DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required to approve/reject flagged product reviews from Store customisation.
# Generate a long random secret and set it only in the backend deployment environment.
REVIEW_MODERATION_TOKEN=replace-with-a-long-random-secret

# Optional comma-separated whole words to hold for moderation; defaults to a small profanity list.
# REVIEW_FLAG_WORDS=word1,word2
