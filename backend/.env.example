# Clean modular backend settings (copy into a local .env and replace placeholders).
# Never commit real credentials. Never point local tests at production.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/superbajaar_test
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_ENV=development
APP_NAME=Super Bajaar API
API_PREFIX=/api
JWT_SECRET_KEY=generate-a-random-secret-at-least-32-characters
# If migrating an existing deployment, SB_SECRET_KEY is accepted as a temporary fallback.
PORT=8001

# Legacy signing-secret fallback only; never use it as an admin password.
# Email allowed for the operator-run first Super Admin provisioning command.
SB_SUPER_ADMIN_EMAIL=kpmcenterprise@gmail.com
# Non-interactive first-admin bootstrap (AWS SSM Run Command only):
# Set the full name and a Parameter Store SecureString name; never put the password here.
# SB_SUPER_ADMIN_FULL_NAME=Your Full Name
# SB_SUPER_ADMIN_PASSWORD_PARAMETER=/superbajaar/bootstrap/super-admin-password
SB_SERVICEABLE_PINS=

# Razorpay Standard Checkout (use Test Mode credentials until test verification is complete).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Invitation-only Vendor and Employee portal delivery.
# Set SB_EMAIL_PROVIDER=resend to use Resend; otherwise SMTP remains the default.
SB_EMAIL_PROVIDER=smtp
RESEND_API_KEY=
# Required for Resend's unverified testing sender; must match the Resend account email.
RESEND_TEST_RECIPIENT=
# Identity OTP uses the same Resend integration; use a random 32+ character secret.
IDENTITY_OTP_HMAC_SECRET=
SB_PORTAL_BASE_URL=https://your-current-website-url
SB_SMTP_HOST=
SB_SMTP_PORT=587
SB_SMTP_USERNAME=
SB_SMTP_PASSWORD=
SB_SMTP_FROM=onboarding@resend.dev
# Private invoice and identity-verification document storage (bucket must block all public access).
SB_PRIVATE_DOCUMENT_BUCKET=
# Set to the AWS region where the private document bucket was created.
SB_S3_REGION=ap-south-1
# Public product image storage: deploy backend/infra/product-media-storage.yaml first.
# The bucket stays private; CloudFront is the public delivery URL.
MEDIA_BUCKET=
MEDIA_PUBLIC_BASE_URL=
AWS_REGION=ap-south-1

# --- Customer social sign-in (leave a provider's id/secret blank to disable it) ---
# Google: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
#   Authorized redirect URI: {PUBLIC_API_BASE_URL}/api/customer-auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GitHub: Settings > Developer settings > OAuth Apps.
#   Authorization callback URL: {PUBLIC_API_BASE_URL}/api/customer-auth/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Public URL of this API, no trailing slash (e.g. https://api.yourdomain.com).
PUBLIC_API_BASE_URL=
# Storefront website that receives the signed-in customer (e.g. https://www.yourdomain.com).
FRONTEND_BASE_URL=http://localhost:5173
