DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required to approve/reject flagged product reviews from Store customisation.
# Generate a long random secret and set it only in the backend deployment environment.
REVIEW_MODERATION_TOKEN=replace-with-a-long-random-secret

# Optional comma-separated whole words to hold for moderation; defaults to a small profanity list.
# REVIEW_FLAG_WORDS=word1,word2

# Authentication settings (set real values only in deployment secrets; never commit real secrets).
# AUTH_TOKEN_SECRET: generate at least 32 random characters.
# SUPER_ADMIN_EMAIL: the single email authorized for initial Super Admin setup.
# SUPER_ADMIN_BOOTSTRAP_KEY: generate a random one-time bootstrap key of at least 24 characters.
